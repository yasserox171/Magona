# Server
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://magona:magona@localhost:5432/magona?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Maps / geocoding (Google Maps or Mapbox — set one)
MAPS_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Flight tracking (optional third-party integration, e.g. AeroDataBox/FlightAware)
FLIGHT_TRACKING_API_KEY=

# Email (SMTP). Leave empty in dev to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Magona <no-reply@magona.com>"

# Push notifications (Web Push / FCM)
FCM_SERVER_KEY=

# Misc
THROTTLE_TTL=60
THROTTLE_LIMIT=100
