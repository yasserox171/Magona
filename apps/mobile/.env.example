# Base URL of the Magona API, including the /api/v1 prefix.
#
# - Android emulator talking to an API running on your host machine: use 10.0.2.2
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
# - Physical device on the same Wi-Fi as your API host: use your machine's LAN IP
#     EXPO_PUBLIC_API_URL=http://192.168.1.23:4000/api/v1
# - Deployed API:
#     EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_WS_URL=http://10.0.2.2:4000
